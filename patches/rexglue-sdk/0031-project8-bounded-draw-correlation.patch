diff --git a/include/rex/graphics/project8_draw_capture.h b/include/rex/graphics/project8_draw_capture.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/project8_draw_capture.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+namespace rex::graphics {
+struct Project8VertexPreparation { uint32_t source_address, destination_address, source_bytes, destination_bytes; };
+// Final draw facts only; no guest bytes, texture keys or resource contents.
+struct Project8DrawMetadata {
+  uint32_t primitive, guest_vertices, host_vertices, vertex_address, vertex_size, vertex_stride_words;
+  uint32_t index_type, index_format, index_address, index_bytes;
+  uint64_t vs_hash, ps_hash;
+  uint32_t textures, render_target, depth_control, blend_control;
+  float viewport[4];
+};
+void BeginProject8DrawCorrelation(uint64_t guest_swap_ordinal);
+void EndProject8DrawCorrelation(uint64_t guest_swap_ordinal);
+bool IsProject8DrawCorrelationActive();
+void RecordProject8VertexPreparation(const Project8VertexPreparation& record);
+void RecordProject8DrawMetadata(const Project8DrawMetadata& record);
+}  // namespace rex::graphics
