diff --git a/src/core/project8_draw_capture.cpp b/src/core/project8_draw_capture.cpp
new file mode 100644
--- /dev/null
+++ b/src/core/project8_draw_capture.cpp
@@ -0,0 +1,60 @@
+#include <rex/graphics/project8_draw_capture.h>
+#include <array>
+#include <atomic>
+#include <mutex>
+#include <rex/logging.h>
+namespace rex::graphics { namespace {
+constexpr uint32_t kMaximumPreparations = 8, kMaximumDraws = 8;
+std::atomic<bool> active{false};
+std::atomic<uint64_t> opening_swap{0};
+std::atomic<uint32_t> preparation_count{0}, draw_count{0};
+std::array<Project8VertexPreparation, kMaximumPreparations> preparations{};
+std::array<Project8DrawMetadata, kMaximumDraws> draws{};
+std::mutex records_mutex;
+}  // namespace
+void BeginProject8DrawCorrelation(uint64_t swap) {
+  std::lock_guard<std::mutex> lock(records_mutex);
+  preparation_count.store(0, std::memory_order_relaxed);
+  draw_count.store(0, std::memory_order_relaxed);
+  opening_swap.store(swap, std::memory_order_relaxed);
+  active.store(true, std::memory_order_release);
+}
+void EndProject8DrawCorrelation(uint64_t swap) {
+  if (!active.exchange(false, std::memory_order_acq_rel)) return;
+  std::lock_guard<std::mutex> lock(records_mutex);
+  const uint32_t preps = preparation_count.load(std::memory_order_acquire);
+  const uint32_t draw_total = draw_count.load(std::memory_order_acquire);
+  REXLOG_INFO("P8_DRAW_CORRELATION swap_open={} swap_close={} preps={} draws={}{}{}",
+              opening_swap.load(std::memory_order_relaxed), swap, preps, draw_total,
+              preps > kMaximumPreparations ? " preps_truncated=1" : "",
+              draw_total > kMaximumDraws ? " draws_truncated=1" : "");
+  for (uint32_t i = 0; i < preps && i < kMaximumPreparations; ++i) {
+    const auto& r = preparations[i];
+    REXLOG_INFO("P8_DRAW_CORRELATION prep={} source={:08X} destination={:08X} input={} output={}",
+                i, r.source_address, r.destination_address, r.source_bytes, r.destination_bytes);
+  }
+  for (uint32_t i = 0; i < draw_total && i < kMaximumDraws; ++i) {
+    const auto& r = draws[i];
+    REXLOG_INFO("P8_DRAW_CORRELATION draw={} primitive={} vertices={}/{} vertex={:08X}+{} stride={} index=type:{} format:{} {:08X}+{} vs={:016X} ps={:016X} textures={:08X} rt={:08X} depth={:08X} blend={:08X} viewport={},{},{},{}",
+                i, r.primitive, r.guest_vertices, r.host_vertices, r.vertex_address, r.vertex_size,
+                r.vertex_stride_words, r.index_type, r.index_format, r.index_address, r.index_bytes,
+                r.vs_hash, r.ps_hash, r.textures, r.render_target, r.depth_control, r.blend_control,
+                r.viewport[0], r.viewport[1], r.viewport[2], r.viewport[3]);
+  }
+}
+bool IsProject8DrawCorrelationActive() { return active.load(std::memory_order_acquire); }
+void RecordProject8VertexPreparation(const Project8VertexPreparation& r) {
+  if (!active.load(std::memory_order_acquire)) return;
+  std::lock_guard<std::mutex> lock(records_mutex);
+  if (!active.load(std::memory_order_relaxed)) return;
+  const uint32_t i = preparation_count.fetch_add(1, std::memory_order_relaxed);
+  if (i < kMaximumPreparations) preparations[i] = r;
+}
+void RecordProject8DrawMetadata(const Project8DrawMetadata& r) {
+  if (!active.load(std::memory_order_acquire)) return;
+  std::lock_guard<std::mutex> lock(records_mutex);
+  if (!active.load(std::memory_order_relaxed)) return;
+  const uint32_t i = draw_count.fetch_add(1, std::memory_order_relaxed);
+  if (i < kMaximumDraws) draws[i] = r;
+}
+}  // namespace rex::graphics
