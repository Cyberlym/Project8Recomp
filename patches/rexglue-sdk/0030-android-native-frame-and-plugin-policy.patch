+void AndroidPerformanceRecordGuestFrame() {
+  const int64_t now_ns = MonotonicNowNs();
+  const int64_t previous_ns =
+      last_guest_frame_monotonic_ns.exchange(now_ns, std::memory_order_relaxed);
+  if (previous_ns > 0 && now_ns > previous_ns) {
+    last_guest_frame_interval_ns.store(now_ns - previous_ns, std::memory_order_relaxed);
+  }
+  const uint64_t ordinal = guest_frame_count.fetch_add(1, std::memory_order_release);
+  guest_frame_timestamps[ordinal % kGuestFrameTimestampCapacity].store(
+      now_ns, std::memory_order_release);
+}
