+struct GuestFrameWindow {
+  uint64_t count = 0;
+  int64_t elapsed_ns = 0;
+};
+
+GuestFrameWindow GetGuestFrameWindow(int64_t now_ns) {
+  const uint64_t total = guest_frame_count.load(std::memory_order_acquire);
+  if (!total) {
+    return {};
+  }
+  const uint64_t newest_ordinal = total - 1;
+  const int64_t newest_ns =
+      guest_frame_timestamps[newest_ordinal % kGuestFrameTimestampCapacity].load(
+          std::memory_order_acquire);
+  if (newest_ns <= 0 || now_ns < newest_ns || now_ns - newest_ns > 1000000000LL) {
+    return {};
+  }
+  const uint64_t first_available =
+      total > kGuestFrameTimestampCapacity ? total - kGuestFrameTimestampCapacity : 0;
+  uint64_t oldest_ordinal = newest_ordinal;
+  int64_t oldest_ns = newest_ns;
+  while (oldest_ordinal > first_available) {
+    const uint64_t candidate_ordinal = oldest_ordinal - 1;
+    const int64_t candidate_ns =
+        guest_frame_timestamps[candidate_ordinal % kGuestFrameTimestampCapacity].load(
+            std::memory_order_acquire);
+    if (candidate_ns <= 0 || candidate_ns > oldest_ns || now_ns - candidate_ns > 1000000000LL) {
+      break;
+    }
+    oldest_ordinal = candidate_ordinal;
+    oldest_ns = candidate_ns;
+  }
+  return {newest_ordinal - oldest_ordinal + 1, newest_ns - oldest_ns};
+}
+
