--- a/src/ui/window_sdl.cpp
+++ b/src/ui/window_sdl.cpp
@@ -30,6 +30,7 @@

 #if REX_PLATFORM_ANDROID
 #include <rex/ui/surface_android.h>
+#include "ui/android_presentation_diagnostics.h"
 #elif REX_PLATFORM_WIN32
 #include <rex/ui/surface_win.h>
 #elif REX_PLATFORM_MAC
@@ -380,7 +381,20 @@ std::unique_ptr<Surface> WindowSDL::CreateSurfaceImpl(Surface::TypeFlags allowed
   }
 #if REX_PLATFORM_ANDROID
   if (allowed_types & Surface::kTypeFlag_AndroidNativeWindow) {
-    return AndroidNativeWindowSurface::Create(sdl_window_);
+    auto surface = AndroidNativeWindowSurface::Create(sdl_window_);
+#if defined(REXGLUE_ANDROID_PRESENTATION_DIAGNOSTICS)
+    uint32_t width = 0;
