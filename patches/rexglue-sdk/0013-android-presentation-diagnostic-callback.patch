diff --git a/src/ui/android_presentation_diagnostics.cpp b/src/ui/android_presentation_diagnostics.cpp
new file mode 100644
index 0000000..80d126e
--- /dev/null
+++ b/src/ui/android_presentation_diagnostics.cpp
@@ -0,0 +1,32 @@
+#include <rex/platform.h>
+
+#include "ui/android_presentation_diagnostics.h"
+
+#if REX_PLATFORM_ANDROID && defined(REXGLUE_ANDROID_PRESENTATION_DIAGNOSTICS)
+
+#include <atomic>
+
+namespace rex::ui {
+namespace {
+
+std::atomic<AndroidPresentationDiagnosticCallback> diagnostic_callback{nullptr};
+
+}  // namespace
+
+void SetAndroidPresentationDiagnosticCallback(
+    AndroidPresentationDiagnosticCallback callback) {
+  diagnostic_callback.store(callback, std::memory_order_release);
+}
+
+void AndroidPresentationDiagnostic(AndroidPresentationDiagnosticEvent event,
+                                   int32_t result, uintptr_t handle,
+                                   uint32_t width, uint32_t height) {
+  auto callback = diagnostic_callback.load(std::memory_order_acquire);
+  if (callback) {
+    callback(event, result, handle, width, height);
+  }
+}
+
+}  // namespace rex::ui
+
+#endif
