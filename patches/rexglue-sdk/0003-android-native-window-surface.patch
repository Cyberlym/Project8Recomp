diff --git a/src/ui/surface_android.cpp b/src/ui/surface_android.cpp
new file mode 100644
index 0000000..44afaac
--- /dev/null
+++ b/src/ui/surface_android.cpp
@@ -0,0 +1,36 @@
+#include <SDL3/SDL_video.h>
+
+#include <rex/ui/surface_android.h>
+
+namespace rex::ui {
+
+std::unique_ptr<AndroidNativeWindowSurface>
+AndroidNativeWindowSurface::Create(SDL_Window* sdl_window) {
+  if (!sdl_window) {
+    return nullptr;
+  }
+  auto* native_window = static_cast<ANativeWindow*>(SDL_GetPointerProperty(
+      SDL_GetWindowProperties(sdl_window),
+      SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, nullptr));
+  if (!native_window) {
+    return nullptr;
+  }
+  return std::unique_ptr<AndroidNativeWindowSurface>(
+      new AndroidNativeWindowSurface(sdl_window, native_window));
+}
+
+bool AndroidNativeWindowSurface::GetSizeImpl(uint32_t& width_out,
+                                             uint32_t& height_out) const {
+  int pixel_width = 0;
+  int pixel_height = 0;
+  if (!sdl_window_ || !native_window_ ||
+      !SDL_GetWindowSizeInPixels(sdl_window_, &pixel_width, &pixel_height) ||
+      pixel_width <= 0 || pixel_height <= 0) {
+    return false;
+  }
+  width_out = uint32_t(pixel_width);
+  height_out = uint32_t(pixel_height);
+  return true;
+}
+
+}  // namespace rex::ui
