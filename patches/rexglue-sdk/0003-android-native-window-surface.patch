diff --git a/include/rex/ui/surface_android.h b/include/rex/ui/surface_android.h
new file mode 100644
index 0000000..247ac3b
--- /dev/null
+++ b/include/rex/ui/surface_android.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <memory>
+
+#include <rex/ui/surface.h>
+
+struct ANativeWindow;
+struct SDL_Window;
+
+namespace rex::ui {
+
+class AndroidNativeWindowSurface final : public Surface {
+ public:
+  static std::unique_ptr<AndroidNativeWindowSurface> Create(
+      SDL_Window* sdl_window);
+
+  TypeIndex GetType() const override { return kTypeIndex_AndroidNativeWindow; }
+  ANativeWindow* window() const { return native_window_; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override;
+
+ private:
+  AndroidNativeWindowSurface(SDL_Window* sdl_window,
+                             ANativeWindow* native_window)
+      : sdl_window_(sdl_window), native_window_(native_window) {}
+
+  // SDL owns both handles. Window tears this wrapper down before
+  // SDL_DestroyWindow.
+  SDL_Window* sdl_window_;
+  ANativeWindow* native_window_;
+};
+
+}  // namespace rex::ui
