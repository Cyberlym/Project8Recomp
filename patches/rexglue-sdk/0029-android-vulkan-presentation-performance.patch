diff --git a/src/ui/android_performance.cpp b/src/ui/android_performance.cpp
new file mode 100644
index 0000000..bbef683
--- /dev/null
+++ b/src/ui/android_performance.cpp
@@ -0,0 +1,79 @@
+#include <rex/ui/android_performance.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <atomic>
+#include <chrono>
+
+namespace rex::ui {
+namespace {
+
+std::atomic<uint64_t> successful_present_count{0};
+std::atomic<int64_t> last_present_monotonic_ns{0};
+std::atomic<int64_t> last_present_interval_ns{0};
+std::atomic<uint64_t> skipped_placeholder_present_count{0};
+std::atomic<uint64_t> graphics_pipeline_create_count{0};
+std::atomic<uint64_t> shader_translate_count{0};
+std::atomic<uint64_t> pipeline_description_cache_hit_count{0};
+std::atomic<uint64_t> pipeline_description_cache_miss_count{0};
+std::atomic<uint64_t> swapchain_recreation_count{0};
+
+int64_t MonotonicNowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+}  // namespace
+
+void AndroidPerformanceRecordSuccessfulPresent() {
+  const int64_t now_ns = MonotonicNowNs();
+  const int64_t previous_ns =
+      last_present_monotonic_ns.exchange(now_ns, std::memory_order_relaxed);
+  if (previous_ns > 0 && now_ns > previous_ns) {
+    last_present_interval_ns.store(now_ns - previous_ns, std::memory_order_relaxed);
+  }
+  successful_present_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void AndroidPerformanceRecordSkippedPlaceholderPresent() {
+  skipped_placeholder_present_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void AndroidPerformanceRecordGraphicsPipelineCreate() {
+  graphics_pipeline_create_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void AndroidPerformanceRecordShaderTranslate() {
+  shader_translate_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void AndroidPerformanceRecordPipelineDescriptionCacheHit() {
+  pipeline_description_cache_hit_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void AndroidPerformanceRecordPipelineDescriptionCacheMiss() {
+  pipeline_description_cache_miss_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void AndroidPerformanceRecordSwapchainRecreation() {
+  swapchain_recreation_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+AndroidPresentationPerformanceSnapshot AndroidPerformanceGetSnapshot() {
+  return {
+      successful_present_count.load(std::memory_order_relaxed),
+      last_present_monotonic_ns.load(std::memory_order_relaxed),
+      last_present_interval_ns.load(std::memory_order_relaxed),
+      MonotonicNowNs(),
+      skipped_placeholder_present_count.load(std::memory_order_relaxed),
+      graphics_pipeline_create_count.load(std::memory_order_relaxed),
+      shader_translate_count.load(std::memory_order_relaxed),
+      pipeline_description_cache_hit_count.load(std::memory_order_relaxed),
+      pipeline_description_cache_miss_count.load(std::memory_order_relaxed),
+      swapchain_recreation_count.load(std::memory_order_relaxed),
+  };
+}
+
+}  // namespace rex::ui
+
+#endif  // REX_PLATFORM_ANDROID
