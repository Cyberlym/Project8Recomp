@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstdint>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+namespace rex::ui {
+
+// Lifetime counters sampled by the Android debug overlay. They intentionally
+// describe presentation, not guest swaps: a frame that never reaches
+// vkQueuePresentKHR must not be reported as visible performance.
+struct AndroidPresentationPerformanceSnapshot {
+  uint64_t successful_present_count;
+  int64_t last_present_monotonic_ns;
+  int64_t last_present_interval_ns;
+  int64_t snapshot_monotonic_ns;
+  uint64_t skipped_placeholder_present_count;
+  uint64_t graphics_pipeline_create_count;
+  uint64_t shader_translate_count;
+  uint64_t pipeline_description_cache_hit_count;
+  uint64_t pipeline_description_cache_miss_count;
+  uint64_t swapchain_recreation_count;
+};
+
+void AndroidPerformanceRecordSuccessfulPresent();
+void AndroidPerformanceRecordSkippedPlaceholderPresent();
+void AndroidPerformanceRecordGraphicsPipelineCreate();
+void AndroidPerformanceRecordShaderTranslate();
+void AndroidPerformanceRecordPipelineDescriptionCacheHit();
+void AndroidPerformanceRecordPipelineDescriptionCacheMiss();
+void AndroidPerformanceRecordSwapchainRecreation();
+
+AndroidPresentationPerformanceSnapshot AndroidPerformanceGetSnapshot();
+
+}  // namespace rex::ui
+
+#endif  // REX_PLATFORM_ANDROID
